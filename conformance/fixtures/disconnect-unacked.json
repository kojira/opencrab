{
  "name": "disconnect-unacked",
  "prelude": "hello",
  "steps": [
    {
      "op": "http_post",
      "path": "/api/web-conversations/web-agent-conv/messages",
      "body": {
        "client_message_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
        "text": "hello",
        "attachments": []
      },
      "status": 503,
      "body_expect": { "error": { "code": "instance_not_ready" } }
    },
    {
      "op": "uds_send",
      "frame": {
        "id": "bind:bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "m": "bind",
        "binding_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "address": "web-agent-conv"
      }
    },
    {
      "op": "uds_recv",
      "expect": { "m": "ok", "id": "bind:bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb" }
    },
    {
      "op": "sse_open",
      "id": "ev",
      "path": "/api/web-conversations/web-agent-conv/events"
    },
    { "op": "uds_close" },
    {
      "op": "sse_recv",
      "id": "ev",
      "event": "gate_error",
      "data": { "code": "disconnect" }
    },
    { "op": "uds_unlisten" },
    {
      "op": "http_post",
      "path": "/api/web-conversations/web-agent-conv/messages",
      "body": {
        "client_message_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
        "text": "hello",
        "attachments": []
      },
      "status": 503,
      "body_expect": { "error": { "code": "disconnect" } }
    }
  ]
}
