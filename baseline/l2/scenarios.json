  "tool_execution": {
    "selected_facets": [
      "empty arguments for every observed tool whose live schema declares required fields",
      "direct-call permission rejection for every observed owner-only, trusted-only, and trusted-only-MCP tool",
      "contained successful calls spanning core read/control, workspace mutation, task state, system gateway reads, and MCP",
      "MCP tool-declared failure and forwarding/transport failure"
    ],
    "why": "Visibility alone does not prove direct invocation is gated or that result/error translation survives a replacement.",
    "non_selected_success_policy": "A tool without a credential-free and side-effect-contained successful scenario is emitted as uncollected instead of being called with guessed arguments.",
    "success_fixture": {
      "workspace": "Fresh temporary roots contain only collector-owned files. The collector creates a fixed baseline-command executable fixture and an empty import-source directory outside agent workspaces; tool cases create captured/, captured/file.txt, captured/summary.txt, and skills/captured-skill.skill.md through the real tools. The shell allowlist contains only the absolute path of baseline-command, and its subprocess environment is empty.",
      "core_db": "A fresh in-memory DB contains agent baseline-agent, two fixed session logs for baseline-session (ids 1 and 2), active owner-created skill Seed Skill, topic t1, declared units u1/u2, condensed cores m1/m2, and category nodes c1/c2/c3. Fixed timestamps and IDs are used only as preconditions; tool-created IDs come from the implementation and are normalized after capture.",
      "gateway_db": "A separate fresh in-memory AppState DB contains baseline-agent and a disabled Nostr row with a deterministic non-production fixture nsec. No production credential, operator workspace, network service, or live gateway is used.",
      "session": "Gateway self-management calls use web-baseline-agent-conversation so the production TimedFire descriptor resolves a real local web session target. History reads use baseline-session.",
      "subtasks": "cancel_subtask, steer_subtask, and report_progress receive an in-memory running SubtaskRegistry entry with id baseline-subtask, parent web-baseline-agent-conversation, sub-session subtask-baseline-subtask, an actual pending Tokio abort handle, owner caller, and the real lifecycle latch. spawn_subtask receives a real registry and runs the real spawn path; its background LLM run has no provider and is not represented as a successful completion.",
      "mcp": "Two in-memory McpServer implementations expose public_local/echo and trusted_local/echo. Calls traverse the real McpToolProvider and BridgedExecutor."
    },
