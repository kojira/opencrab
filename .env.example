# cp .env.example .env してから値を埋める。
# サーバー / CLI は起動時に .env を読み込み、config/default.toml の ${VAR} を展開する。
# 未定義の ${VAR} は空文字に展開される（設定ファイル側でエラーにはならない）。

# LLM Provider API Keys
# 既定構成（config/default.toml.example）では OPENAI_API_KEY は参照されていない。
# [llm.providers.openai] が api_key = "dummy" とローカルの base_url
# (http://localhost:8765/v1 = hermit-shell) を指しているため。
# 本物の OpenAI API を直接使う場合に api_key = "${OPENAI_API_KEY}" へ変更して使う。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional
DISCORD_TOKEN=

# Discord: 環境ごとに変わるローカル固有値。config/default.toml から
# ${...} で参照される。
# 自分の Discord ユーザー ID（18 桁程度の数値）。オーナー専用機能・DM 受付・
# オーナー専用 UI の操作者チェックに使う。空のままにすると、誰も owner と
# 判定されずオーナー専用機能が使えなくなる一方で、信頼ユーザーが未登録の
# エージェントでは DM が全許可になり、オーナー専用 UI も開く（docs/discord.md 参照）。
# Discord ゲートウェイを使うなら必ず設定する。
OWNER_DISCORD_ID=
# spawn_subtask の lifecycle 通知に使う Discord webhook URL。空なら無効。
DISCORD_SUBTASK_WEBHOOK_URL=

# ============================================================
# ローカル専用 E2E テストハーネス（crates/server/tests/e2e_local.rs / issue #162）
# ============================================================
# CI 非対象。稼働中サーバ（./dev.sh restart）を HTTP/SSE で叩き、実 LLM で
# ツール呼び出し/停止の E2E 挙動を検証する。実行例:
#   OPENCRAB_E2E=1 cargo test -p opencrab-server --test e2e_local -- --ignored --nocapture
# 機密は書かないこと（下記はプレースホルダ/既定値のみ）。
#
# ゲート。"1" のときだけ E2E テストが有効化される（未設定なら各テストは skip）。
OPENCRAB_E2E=
# 稼働中サーバのベース URL（既定 http://localhost:8080）
OPENCRAB_E2E_BASE_URL=
# テストで使うモデル（既定 chatgpt:gpt-5.6-sol。~/.codex/auth.json 認証をサーバ側で使用）
OPENCRAB_E2E_MODEL=
# 認可判定用の owner user_id（必須・既定なし。未設定なら E2E テストは skip）
OPENCRAB_E2E_OWNER_ID=
# アサート用に read-only で読む sqlite の場所（既定 data/opencrab.db）
OPENCRAB_E2E_DB=
