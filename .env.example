# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional
DISCORD_TOKEN=

# Discord: 環境ごとに変わるローカル固有値。config/default.toml から
# ${...} で参照される（未設定なら空文字として扱われる）。
# DM に応答するオーナーの Discord ユーザー ID。空ならオーナー無し。
OWNER_DISCORD_ID=
# spawn_subtask の lifecycle 通知に使う Discord webhook URL。空なら無効。
DISCORD_SUBTASK_WEBHOOK_URL=
