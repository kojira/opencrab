# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional
DISCORD_TOKEN=

# ============================================================
# ローカル専用 E2E テストハーネス（crates/server/tests/e2e_local.rs / issue #162）
# ============================================================
# CI 非対象。稼働中サーバ（./dev.sh restart）を HTTP/SSE で叩き、実 LLM で
# ツール呼び出し/停止の E2E 挙動を検証する。実行例:
#   OPENCRAB_E2E=1 cargo test -p opencrab-server --test e2e_local -- --ignored --nocapture
# 機密は書かないこと（下記はプレースホルダ/既定値のみ）。
#
# ゲート。"1" のときだけ E2E テストが有効化される（未設定なら各テストは skip）。
OPENCRAB_E2E=
# 稼働中サーバのベース URL（既定 http://localhost:8080）
OPENCRAB_E2E_BASE_URL=
# テストで使うモデル（既定 chatgpt:gpt-5.6-sol。~/.codex/auth.json 認証をサーバ側で使用）
OPENCRAB_E2E_MODEL=
# 認可判定用の owner user_id（必須・既定なし。未設定なら E2E テストは skip）
OPENCRAB_E2E_OWNER_ID=
# アサート用に read-only で読む sqlite の場所（既定 data/opencrab.db）
OPENCRAB_E2E_DB=
